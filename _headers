# Netlify headers, shipped inside dist/ so they also apply to drag-and-drop deploys
# (netlify.toml carries the same rules for Git/CLI deploys).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate
